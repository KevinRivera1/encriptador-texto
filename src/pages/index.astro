---
import Footer from "@/ui/components/Footer.astro";
import Header from "@/ui/components/Header.astro";
import Layout from "@/ui/layouts/Layout.astro";
import buscador from "../../public/buscador.webp";
---

<Layout
  title="Encriptador de Texto"
  description="Encriptador de texto reto de HTML, CSS Y JS"
>
  <Header />
  <main class="main">
    <div class="container">
      <section class="encrypt">
        <form id="encryptForm" class="encrypt__form">
          <textarea
            class="encrypt__textarea"
            name="text-encrypt"
            id="text-encrypt"
            placeholder="Ingrese su texto aquí ..."></textarea>
          <small class="encrypt__warning"
            ><svg
              xmlns="http://www.w3.org/2000/svg"
              width="24"
              height="24"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              class="lucide lucide-triangle-alert"
              ><path
                d="m21.73 18-8-14a2 2 0 0 0-3.48 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"
              ></path><path d="M12 9v4"></path><path d="M12 17h.01"></path></svg
            > Ingrese solo letras no se permite números</small
          >
          <div class="encrypt__btn">
            <button class="btn encrypt__btn--encriptar" type="submit">
              Encriptar
            </button>
            <button class="btn encrypt__btn--desencriptar">
              Desencriptar
            </button>
          </div>
        </form>
      </section>
      <section class="message">
        <figure class="message__image">
          <img
            class="img"
            src={buscador.src}
            alt="Imagen mensaje"
            id="img"
            loading="lazy"
          />
        </figure>
        <div class="message">
          <div class="message__content">
            <input
              class="message__text"
              id="resultText"
              type="text"
              placeholder="El Resultado aparecerá aquí..."
              readonly
            />
            <button id="message__btn-copy" class="message__btn">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                class="message__icon"
              >
                <rect width="14" height="14" x="8" y="8" rx="2" ry="2"></rect>
                <path
                  d="M4 16c-1.1 0-2-.9-2-2V4c0-1.1.9-2 2-2h10c1.1 0 2 .9 2 2"
                ></path>
              </svg>
            </button>
          </div>
          <small class="message__info">Ningún mensaje fue encontrado</small>
          <small class="message__info"
            >Ingresa el texto que desees encriptar o desencriptar</small
          >
        </div>
      </section>
    </div>
  </main>
</Layout>

<script>
  document.addEventListener("DOMContentLoaded", () => {

    const ALPHABET = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz";
    const SPACE_PLACEHOLDER = "#$%&*";
    const SHIFT = 3;

    const form = document.getElementById(
      "encryptForm",
    ) as HTMLFormElement | null;

    const inputTextArea = document.getElementById(
      "text-encrypt",
    ) as HTMLTextAreaElement | null;

    const btnDesencriptar = document.querySelector(
      ".encrypt__btn--desencriptar",
    ) as HTMLButtonElement | null;

    const resultInput = document.getElementById(
      "resultText",
    ) as HTMLInputElement | null;

    const btnCopiar = document.getElementById(
      "message__btn-copy",
    ) as HTMLButtonElement | null;

    // =========================
    // Validaciones
    // =========================

    const validateElements = (): boolean => {
      if (!form) {
        console.error("No se encontró el formulario.");
        return false;
      }

      if (!inputTextArea) {
        console.error("No se encontró el textarea.");
        return false;
      }

      if (!btnDesencriptar) {
        console.error("No se encontró el botón de desencriptar.");
        return false;
      }

      if (!resultInput) {
        console.error("No se encontró el campo de resultado.");
        return false;
      }

      if (!btnCopiar) {
        console.error("No se encontró el botón de copiar.");
        return false;
      }

      return true;
    };

    // =========================
    // Funciones de encriptado
    // =========================

    const shiftText = (
      text: string,
      shift: number,
      direction: "encrypt" | "decrypt",
    ): string => {
      if (!text) return "";

      const normalizedShift = shift % ALPHABET.length;

      const shiftAlphabet =
        direction === "encrypt"
          ? ALPHABET.slice(normalizedShift) + ALPHABET.slice(0, normalizedShift)
          : ALPHABET.slice(-normalizedShift) +
            ALPHABET.slice(0, -normalizedShift);

      const space = direction === "encrypt" ? " " : SPACE_PLACEHOLDER;

      const replacement = direction === "encrypt" ? SPACE_PLACEHOLDER : " ";

      return text
        .replaceAll(space, replacement)
        .split("")
        .map((char) => {
          const index = ALPHABET.indexOf(char);

          if (index === -1) {
            return char;
          }

          return shiftAlphabet[index];
        })
        .join("");
    };

    const encryptText = (text: string): string => {
      return shiftText(text, SHIFT, "encrypt");
    };

    const decryptText = (text: string): string => {
      return shiftText(text, SHIFT, "decrypt");
    };

    // =========================
    // Operaciones
    // =========================

    const handleEncrypt = (): void => {
      const text = inputTextArea!.value.trim();

      if (!text) {
        alert("Por favor, ingresa un texto para encriptar.");
        return;
      }
      const encryptedText = encryptText(text);

      resultInput!.value = encryptedText;

      alert("Texto encriptado correctamente.");
    };

    const handleDecrypt = (): void => {
      const text = resultInput!.value.trim();

      if (!text) {
        alert("Por favor, ingresa un texto para desencriptar.");
        return;
      }

      const decryptedText = decryptText(text);

      resultInput!.value = decryptedText;

      alert("Texto desencriptado correctamente.");
    };

    const handleCopy = (): void => {
      const text = resultInput!.value.trim();

      if (!text) {
        alert("No hay texto para copiar.");
        return;
      }

      navigator.clipboard.writeText(text).then(
        () => alert("Texto copiado al portapapeles."),
        () => alert("No se pudo copiar el texto."),
      );
    };

    // =========================
    // Eventos
    // =========================

    const initializeEvents = (): void => {
      form!.addEventListener("submit", (event) => {
        event.preventDefault();
        handleEncrypt();
      });

      btnDesencriptar!.addEventListener("click", (event) => {
        event.preventDefault();
        handleDecrypt();
      });

      btnCopiar!.addEventListener("click", (event) => {
        event.preventDefault();
        handleCopy();
      });
    };

    // =========================
    // Inicialización
    // =========================

    if (!validateElements()) {
      return;
    }

    initializeEvents();
  });
</script>
